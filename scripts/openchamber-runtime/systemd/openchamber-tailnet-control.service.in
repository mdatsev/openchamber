[Unit]
Description=OpenChamber Tailnet runtime control
After=network-online.target opencode.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@CUSTOM_REPO@
Environment="PATH=@SERVICE_PATH@"
Environment="OPENCHAMBER_TAILNET_CONTROL_PORT=8780"
Environment="OPENCHAMBER_SWITCH_BIN=@BIN_DIR@/openchamber-switch"
ExecStart=@NODE_BIN@ @RUNTIME_DIR@/tailnet-control.mjs
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
