[Unit]
Description=OpenChamber regular interface for external OpenCode
After=network-online.target opencode.service
Wants=network-online.target
Requires=opencode.service
Conflicts=openchamber-custom.service

[Service]
Type=simple
WorkingDirectory=@HOME@/projects
Environment="PATH=@SERVICE_PATH@"
Environment="OPENCODE_HOST=http://127.0.0.1:4096"
Environment="OPENCODE_SKIP_START=true"
ExecStart=@OPENCHAMBER_BIN@ serve --foreground --host 127.0.0.1 --port 8792
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
